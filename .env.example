# Supabase project for the shared feed, profiles and Comune challenges.
# Both values are public (row level security protects the data). Never put a secret key here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional AI backend for Leaf. Model keys stay on that server.
EXPO_PUBLIC_LEAF_ENDPOINT=

# Optional, build-time only: restricted Google Maps SDK for Android key.
# Without it the profile uses a tile preview. Never commit a real key.
GOOGLE_MAPS_API_KEY=
